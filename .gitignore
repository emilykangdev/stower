.build/
.swiftpm/
DerivedData/
*.xcuserdatad/
# Package.resolved is intentionally NOT gitignored — Stower is an app, not a
# library. Apps commit Package.resolved for reproducible builds.
.DS_Store
# All of tmp/ is local scratch — plans, briefs, reviews, retros, research. Never
# commit it; archive anything worth keeping to a history repo so old plans and
# scratch don't pollute the codebase.
tmp/
.gstack/

# Adversarial review run logs (diffs, findings, stderr) — local scratch only.
.ship-with-codex/

# Converted embedding model artifacts. The conversion script writes to the
# user-level app-support dir by default; repo-relative Models/ is a safety net.
Models/
# Personal eval query files (natural-language queries over real messages).
*.local.txt
# On-device persistent stores (reply-verdict cache, embeddings) — written to the
# app-support dir at runtime; repo-relative *.sqlite is a safety net so a stray
# store never gets committed. Disposable: no plaintext, rebuildable on fault.
*.sqlite
*.sqlite-wal
*.sqlite-shm
# Python bytecode cache from the conversion script.
__pycache__/
