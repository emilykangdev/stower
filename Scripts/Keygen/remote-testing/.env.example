# Remote-testing Keygen provisioner config. Copy to `.env` in this folder and fill
# in your real values, then run create-policies.ts. The real `.env` is gitignored —
# the admin token is a secret, never commit it.
#
#   cp Scripts/Keygen/remote-testing/.env.example Scripts/Keygen/remote-testing/.env
#   # …edit .env…
#   deno run --allow-env --allow-net=api.keygen.sh \
#     --env-file=Scripts/Keygen/remote-testing/.env \
#     Scripts/Keygen/remote-testing/create-policies.ts

# Your Keygen Cloud account UUID (the tenant id).
KEYGEN_ACCOUNT=7a4087f0-32e9-46c3-b0b1-c655e5632ab1

# A Keygen PRODUCT token (Bearer).
KEYGEN_PRODUCT_TOKEN=prod-1e9a84f95c5d8732de5f8bc7f107ed2415138c7100b7de1368f5e44afd563a34v3

# The id of the EXISTING product to create the policies under (StowerTest's id).
KEYGEN_PRODUCT_ID=c54b0d83-df49-4954-9f6f-57db8b433501

# Optional — defaults to https://api.keygen.sh (Keygen Cloud). Only set to point at
# a self-hosted Keygen.
# KEYGEN_BASE_URL=https://api.keygen.sh
