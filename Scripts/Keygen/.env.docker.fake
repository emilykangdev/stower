# Throwaway config for the local Keygen Community Edition test harness.
#
# EVERYTHING here is fake and disposable. The harness runs an EPHEMERAL Postgres
# (down.sh wipes the volume), so these encryption keys protect nothing across runs
# and are safe to commit — there is no persisted ciphertext for them to guard. The
# only secret-bearing file is `.runtime.env`, which up.sh mints fresh each run and
# .gitignore excludes. Do NOT point this harness at a real Keygen account.

# The account id (a fixed lowercase UUID, by choice). In singleplayer mode this is
# the tenant id; the script reads it back as KEYGEN_ACCOUNT. Non-secret.
KEYGEN_ACCOUNT_ID=3fd06484-c0a9-402a-8a48-b762abab7622

# The first admin, created by headless `setup`. The admin token is minted from
# this user at runtime by up.sh — never the password itself.
KEYGEN_ADMIN_EMAIL=admin@harness.test
KEYGEN_ADMIN_PASSWORD=harness-admin-pw

# Rails / Keygen encryption material. Throwaway because the DB is ephemeral.
SECRET_KEY_BASE=ea1bd42fb27a0f022464c49ae62e4e35e48cd1bc853439c785f9768a58bd6a79981452945bcd303d5192b2da6fcea9dd907406dee5a03136053874b4146f8938
ENCRYPTION_DETERMINISTIC_KEY=+XoMNDmQNwUzuKUo9Lu3UDrlp4Iv4zV3h8w0zJ8X04Q=
ENCRYPTION_PRIMARY_KEY=Fy0GxHbiDFSoLu7G95yR4wL2KRT3Ub6GEuF0/k933N4=
ENCRYPTION_KEY_DERIVATION_SALT=oo/G28kisc5v7e2uNgih26ap2RzETcuBPAEpinek+AE=
