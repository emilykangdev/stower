    11	        participantHandles: [String],
    12	        contacts: StowerContactsResolver
    13	    ) -> StowerMessageItem? {
    14	        guard row.associatedMessageType == 0, row.itemType == 0,
    15	            row.balloonBundleID == nil || row.balloonBundleID == urlPreviewBalloonBundleID,
    16	            let date = StowerMessageDate.date(from: row.rawDate),
    17	            let body = cleanBody(body)
    18	        else {
    19	            return nil
    20	        }
    21	        let participants = participantHandles.map(contacts.displayName(for:))
    22	        let groupTitle = title(row: row, participants: participants)
    23	        let sender = sender(row: row, contacts: contacts)
    24	        return StowerMessageItem(
    25	            id: row.guid,
    26	            text: body,
    27	            timestamp: date,
    28	            deepLink: deepLink(row: row),
    29	            groupID: groupID(for: row.chat),
    30	            groupTitle: groupTitle,
    31	            isFromMe: row.isFromMe,
    32	            sender: sender
    33	        )
    34	    }
    35	
    36	    private static func cleanBody(_ body: String?) -> String? {
    37	        guard let body else {
    38	            return nil
    39	        }
    40	        let cleaned = body.trimmingCharacters(in: .whitespacesAndNewlines)
    41	        return cleaned.isEmpty ? nil : cleaned
    42	    }
    43	
    44	    private static func title(
    45	        row: StowerSourceMessageRow,
    46	        participants: [String]
    47	    ) -> String {
    48	        let displayName = row.chat.displayName?
    49	            .trimmingCharacters(in: .whitespacesAndNewlines)
    50	        if let displayName, !displayName.isEmpty {
    51	            return displayName
    52	        }
    53	        let uniqueParticipants = Array(Set(participants)).sorted()
    54	        if !uniqueParticipants.isEmpty {
    55	            return uniqueParticipants.joined(separator: ", ")
    56	        }
    57	        return row.chat.identifier
    58	    }
    59	
    60	    private static func sender(
    61	        row: StowerSourceMessageRow,
    62	        contacts: StowerContactsResolver
    63	    ) -> String {
    64	        guard !row.isFromMe else {
    65	            return "Me"
    66	        }
    67	        guard let handle = row.senderHandle, !handle.isEmpty else {
    68	            return "Unknown"
    69	        }
    70	        return contacts.displayName(for: handle)
    71	    }
    72	
    73	    private static func deepLink(row: StowerSourceMessageRow) -> URL? {
    74	        // Group chats stay nil: there is no public per-chat URL, and an
    75	        // sms: compose link with the full recipient set CREATES A NEW group
    76	        // instead of matching the existing one (verified on real data,
    77	        // 2026-06-11). Callers must offer their own navigation fallback.
    78	        guard row.chat.style == 45 else {
    79	            return nil
    80	        }
    81	        // chat_identifier is the chat's canonical counterpart address. The
    82	        // participant list can hold several handles for one person (old
    83	        // email + current phone), so picking any of those can open the
    84	        // wrong conversation in Messages.
    85	        let address = row.chat.identifier.trimmingCharacters(in: .whitespaces)
    86	        return address.isEmpty ? nil : URL(string: "sms:\(address)")
    87	    }
    88	
    89	    private static func groupID(for chat: StowerSourceChatRow) -> String {
    90	        if let guid = chat.guid, !guid.isEmpty {
    91	            return guid
    92	        }
    93	        if !chat.identifier.isEmpty {
    94	            return chat.identifier
    95	        }
    96	        return "chat:\(chat.rowID)"
    97	    }
    98	}

