   239	
   240	    /// Walks the underlying-error chain because Cocoa wraps the TCC denial
   241	    /// differently per operation: a direct read fails with
   242	    /// NSFileReadNoPermissionError, while a copy fails with
   243	    /// NSFileWriteNoPermissionError blaming the destination, and the POSIX
   244	    /// EACCES/EPERM sits one or more levels down in NSUnderlyingErrorKey.
   245	    private static func isPermissionDenied(_ error: Error) -> Bool {
   246	        var current: NSError? = error as NSError
   247	        while let nsError = current {
   248	            if isPOSIXDenial(nsError) || isCocoaDenial(nsError) {
   249	                return true
