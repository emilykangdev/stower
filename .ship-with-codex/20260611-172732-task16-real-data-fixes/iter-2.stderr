   225	    /// Maps a copy-step failure to a `StowerMessagesError`.
   226	    ///
   227	    /// Only ever called on the source `copyItem` step (see `copySource`), so a
   228	    /// permission denial here means macOS withheld Full Disk Access from the
   229	    /// source DB. Already-classified errors pass through unchanged.
   230	    internal static func classify(_ error: Error, sourceURL: URL) -> StowerMessagesError {
   231	        if let classified = error as? StowerMessagesError {
   232	            return classified
   233	        }
   234	        if isPermissionDenied(error) {
   235	            return .fullDiskAccessMissing(sourceURL.path)
   236	        }
   237	        return .unreadableSource((error as NSError).localizedDescription)
