   206	    private static func sweepStaleSnapshots(
   207	        in temporaryDirectory: URL,
   208	        fileManager: FileManager
   209	    ) throws {
   210	        let cutoff = Date().addingTimeInterval(-86_400)
   211	        let contents = try fileManager.contentsOfDirectory(
   212	            at: temporaryDirectory,
   213	            includingPropertiesForKeys: [.contentModificationDateKey],
   214	            options: [.skipsHiddenFiles]
   215	        )
   216	        for url in contents where url.lastPathComponent.hasPrefix("stower-msg-") {
   217	            let values = try url.resourceValues(forKeys: [.contentModificationDateKey])
   218	            guard let modified = values.contentModificationDate, modified < cutoff else {
   219	                continue
   220	            }
   221	            try? fileManager.removeItem(at: url)
   222	        }
   223	    }
