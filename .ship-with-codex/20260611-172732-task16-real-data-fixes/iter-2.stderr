   190	    /// Folds copied WAL frames into the private snapshot before read-only use.
   191	    ///
   192	    /// A raw file copy of a WAL-mode database needs recovery and shared-memory
   193	    /// setup, which SQLite refuses on read-only connections. Switching the
   194	    /// private copy back to a rollback journal checkpoints every WAL frame,
   195	    /// deletes the sidecar files, and rewrites the header, so the read-only
   196	    /// open sees a self-contained database. The original Source DB is never
   197	    /// touched.
   198	    private static func recoverWriteAheadLog(at databaseURL: URL) throws {
   199	        let recoveryQueue = try DatabaseQueue(path: databaseURL.path)
   200	        try recoveryQueue.writeWithoutTransaction { database in
   201	            try database.execute(sql: "PRAGMA journal_mode=DELETE")
   202	        }
   203	        try recoveryQueue.close()
   204	    }
