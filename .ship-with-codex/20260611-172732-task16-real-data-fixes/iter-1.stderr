    14	        guard row.associatedMessageType == 0, row.itemType == 0,
    15	            row.balloonBundleID == nil || row.balloonBundleID == urlPreviewBalloonBundleID,
    16	            let date = StowerMessageDate.date(from: row.rawDate),
    17	            let body = cleanBody(body)
    18	        else {
    19	            return nil
    20	        }
    21	        let participants = participantHandles.map(contacts.displayName(for:))
    22	        let groupTitle = title(row: row, participants: participants)
    23	        let sender = sender(row: row, contacts: contacts)
    24	        return StowerMessageItem(
    25	            id: row.guid,
    26	            text: body,
    27	            timestamp: date,
    28	            deepLink: deepLink(row: row),
    29	            groupID: groupID(for: row.chat),
    30	            groupTitle: groupTitle,
    31	            isFromMe: row.isFromMe,
    32	            sender: sender
    33	        )
    34	    }
    35	
    36	    private static func cleanBody(_ body: String?) -> String? {
    37	        guard let body else {
    38	            return nil
    39	        }
    40	        let cleaned = body.trimmingCharacters(in: .whitespacesAndNewlines)
    41	        return cleaned.isEmpty ? nil : cleaned
    42	    }
    43	
    44	    private static func title(
    45	        row: StowerSourceMessageRow,
    46	        participants: [String]
    47	    ) -> String {
    48	        let displayName = row.chat.displayName?
    49	            .trimmingCharacters(in: .whitespacesAndNewlines)
    50	        if let displayName, !displayName.isEmpty {
    51	            return displayName
    52	        }
    53	        let uniqueParticipants = Array(Set(participants)).sorted()
    54	        if !uniqueParticipants.isEmpty {
    55	            return uniqueParticipants.joined(separator: ", ")
    56	        }
    57	        return row.chat.identifier
    58	    }
    59	
    60	    private static func sender(
    61	        row: StowerSourceMessageRow,
    62	        contacts: StowerContactsResolver
    63	    ) -> String {
    64	        guard !row.isFromMe else {
    65	            return "Me"
    66	        }
    67	        guard let handle = row.senderHandle, !handle.isEmpty else {
    68	            return "Unknown"
    69	        }
    70	        return contacts.displayName(for: handle)
    71	    }
    72	
    73	    private static func deepLink(row: StowerSourceMessageRow) -> URL? {
    74	        // Group chats stay nil: there is no public per-chat URL, and an
    75	        // sms: compose link with the full recipient set CREATES A NEW group
    76	        // instead of matching the existing one (verified on real data,
    77	        // 2026-06-11). Callers must offer their own navigation fallback.
    78	        guard row.chat.style == 45 else {
    79	            return nil
    80	        }
    81	        // chat_identifier is the chat's canonical counterpart address. The
    82	        // participant list can hold several handles for one person (old
    83	        // email + current phone), so picking any of those can open the
    84	        // wrong conversation in Messages.
    85	        let address = row.chat.identifier.trimmingCharacters(in: .whitespaces)
    86	        return address.isEmpty ? nil : URL(string: "sms:\(address)")
    87	    }
    88	
    89	    private static func groupID(for chat: StowerSourceChatRow) -> String {
    90	        if let guid = chat.guid, !guid.isEmpty {
    91	            return guid
    92	        }
    93	        if !chat.identifier.isEmpty {
    94	            return chat.identifier
    95	        }
    96	        return "chat:\(chat.rowID)"
    97	    }
    98	}
     1	import Foundation
     2	
     3	/// Reads a validated, read-only snapshot of the local Messages Source DB.
     4	public actor StowerChatDatabaseReader {
     5	    private let snapshot: StowerChatSnapshot
     6	    private let contacts: StowerContactsResolver
     7	
     8	    /// The default local Messages database location.
     9	    public static var defaultSourceURL: URL {
    10	        FileManager.default.homeDirectoryForCurrentUser
    11	            .appendingPathComponent("Library/Messages/chat.db")
    12	    }
    13	
    14	    /// Creates a reader and one reusable ephemeral Source DB snapshot.
    15	    public init(
    16	        sourceURL: URL = StowerChatDatabaseReader.defaultSourceURL,
    17	        contactsResolver: StowerContactsResolver = .live()
    18	    ) throws {
    19	        snapshot = try StowerChatSnapshot(sourceURL: sourceURL)
    20	        contacts = contactsResolver
    21	    }
    22	
    23	    /// Returns decoded, indexable messages from the most recent window.
    24	    public func ingestWindow(
    25	        days: Int = 180,
    26	        now: Date = Date()
    27	    ) throws -> [StowerMessageItem] {
    28	        guard days >= 0 else {
    29	            throw StowerMessagesError.invalidArgument("Window days must not be negative.")
    30	        }
    31	        let startDate = now.addingTimeInterval(-Double(days) * 86_400)
    32	        let source = try snapshot.ingestRows(since: startDate)
    33	        return mapRows(
    34	            source.rows,
    35	            participants: source.participants,
    36	            reverseForDisplay: false
    37	        )
    38	    }
    39	
    40	    /// Returns the newest messages from one chat in chronological display order.
    41	    public func recentMessages(
    42	        chatID: String,
    43	        limit: Int = 100
    44	    ) throws -> [StowerMessageItem] {
    45	        guard limit > 0 else {
    46	            return []
    47	        }
    48	        let source = try snapshot.recentRows(chatID: chatID, limit: limit)
    49	        return mapRows(
    50	            source.rows,
    51	            participants: source.participants,
    52	            reverseForDisplay: true
    53	        )
    54	    }
    55	
    56	    private func mapRows(
    57	        _ rows: [StowerSourceMessageRow],
    58	        participants: [Int64: [String]],
    59	        reverseForDisplay: Bool
    60	    ) -> [StowerMessageItem] {
    61	        var seenGUIDs: Set<String> = []
    62	        let items = rows.compactMap { row -> StowerMessageItem? in
    63	            guard seenGUIDs.insert(row.guid).inserted else {
    64	                return nil
    65	            }
    66	            let body = decodedBody(for: row)
    67	            return StowerMessageMapper.map(
    68	                row: row,
    69	                body: body,
    70	                participantHandles: participants[row.chat.rowID] ?? [],
    71	                contacts: contacts
    72	            )
    73	        }
    74	        return reverseForDisplay ? items.reversed() : items
    75	    }
    76	
    77	    private func decodedBody(for row: StowerSourceMessageRow) -> String? {
    78	        guard let attributedBody = row.attributedBody else {
    79	            return row.text
    80	        }
    81	        do {
    82	            return try StowerAttributedBodyDecoder.decode(attributedBody) ?? row.text
    83	        } catch {
    84	            return row.text
    85	        }
    86	    }
    87	}
     1	import Foundation
     2	import GRDB
     3	
     4	internal enum StowerMessageQuery {
     5	    internal static func ingestRows(
     6	        database: Database,
     7	        since date: Date
     8	    ) throws -> [StowerSourceMessageRow] {
     9	        try StowerSourceMessageRow.fetchAll(
    10	            database,
    11	            sql: baseSelect + """
    12	                WHERE m.date != 0
    13	                  AND \(indexableMessagePredicate)
    14	                  AND \(referenceSecondsExpression) >= ?
    15	                ORDER BY m.date ASC, m.ROWID ASC, c.ROWID ASC
    16	                """,
    17	            arguments: [StowerMessageDate.rawReferenceSeconds(from: date)]
    18	        )
    19	    }
    20	
    21	    internal static func recentRows(
    22	        database: Database,
    23	        chatID: String,
    24	        limit: Int
    25	    ) throws -> [StowerSourceMessageRow] {
    26	        try StowerSourceMessageRow.fetchAll(
    27	            database,
    28	            sql: baseSelect + """
    29	                WHERE m.date != 0
    30	                  AND \(indexableMessagePredicate)
    31	                  AND (c.guid = ? OR c.chat_identifier = ?)
    32	                ORDER BY m.date DESC, m.ROWID DESC
    33	                LIMIT ?
    34	                """,
    35	            arguments: [chatID, chatID, limit]
    36	        )
    37	    }
    38	
    39	    internal static func participants(
    40	        database: Database,
    41	        chatRowIDs: Set<Int64>
    42	    ) throws -> [Int64: [String]] {
    43	        guard !chatRowIDs.isEmpty else {
    44	            return [:]
    45	        }
    46	        // One placeholder per chat; SQLite allows 32,766 parameters, far above
    47	        // any realistic Messages chat count.
    48	        let placeholders = Array(repeating: "?", count: chatRowIDs.count).joined(separator: ",")
    49	        let sortedIDs = chatRowIDs.sorted()
    50	        let rows = try Row.fetchAll(
    51	            database,
    52	            sql: """
    53	                SELECT chj.chat_id AS chat_row_id, h.id AS handle
    54	                FROM chat_handle_join chj
    55	                JOIN handle h ON h.ROWID = chj.handle_id
    56	                WHERE chj.chat_id IN (\(placeholders))
    57	                ORDER BY chj.chat_id ASC, h.id ASC
    58	                """,
    59	            arguments: StatementArguments(sortedIDs)
    60	        )
    61	        return Dictionary(grouping: rows, by: { $0["chat_row_id"] }).mapValues { values in
    62	            values.map { $0["handle"] }
    63	        }
    64	    }
    65	
    66	    /// Matches plain messages plus URL link previews.
    67	    ///
    68	    /// Link previews keep the shared URL as body text; other balloon payloads
    69	    /// (apps, payments) carry no recall-worthy text and are excluded.
    70	    private static let indexableMessagePredicate = """
    71	        m.associated_message_type = 0
    72	          AND m.item_type = 0
    73	          AND (m.balloon_bundle_id IS NULL
    74	               OR m.balloon_bundle_id = '\(StowerMessageMapper.urlPreviewBalloonBundleID)')
    75	          AND (m.text IS NOT NULL OR m.attributedBody IS NOT NULL)
    76	        """
    77	
    78	    private static let referenceSecondsExpression = """
    79	        CASE
    80	          WHEN ABS(m.date) >= \(StowerMessageDate.nanosecondsThreshold)
    81	            THEN CAST(m.date AS REAL) / 1000000000.0
    82	          ELSE CAST(m.date AS REAL)
    83	        END
    84	        """
    85	
    86	    private static let baseSelect = """
    87	        SELECT
    88	          m.ROWID AS message_row_id,
    89	          m.guid AS message_guid,
    90	          m.text AS text,
    91	          m.attributedBody AS attributed_body,
    92	          m.date AS raw_date,
    93	          m.is_from_me AS is_from_me,
    94	          m.handle_id AS handle_id,
    95	          h.id AS sender_handle,
    96	          m.associated_message_type AS associated_message_type,
    97	          m.item_type AS item_type,
    98	          m.cache_has_attachments AS has_attachments,
    99	          m.balloon_bundle_id AS balloon_bundle_id,
   100	          c.ROWID AS chat_row_id,
   101	          c.guid AS chat_guid,
   102	          c.chat_identifier AS chat_identifier,
   103	          c.display_name AS chat_display_name,
   104	          c.style AS chat_style
   105	        FROM message m
   106	        JOIN chat_message_join cmj ON cmj.message_id = m.ROWID
   107	        JOIN chat c ON c.ROWID = cmj.chat_id
   108	        LEFT JOIN handle h ON h.ROWID = m.handle_id
   109	
   110	        """
   111	}
