   211	    internal static func classify(_ error: Error, sourceURL: URL) -> StowerMessagesError {
   212	        let nsError = error as NSError
   213	        let isPOSIXPermissionError =
   214	            nsError.domain == NSPOSIXErrorDomain
   215	            && (nsError.code == Int(EACCES) || nsError.code == Int(EPERM))
   216	        if isPOSIXPermissionError {
   217	            return .fullDiskAccessMissing(sourceURL.path)
   218	        }
   219	        let isCocoaPermissionError =
   220	            nsError.domain == NSCocoaErrorDomain
   221	            && nsError.code == NSFileReadNoPermissionError
   222	        if isCocoaPermissionError {
   223	            return .fullDiskAccessMissing(sourceURL.path)
   224	        }
   225	        return .unreadableSource(nsError.localizedDescription)
   226	    }
   227	}
   228	
   229	private struct SnapshotComponents {
   230	    fileprivate let rootURL: URL
   231	    fileprivate let databaseURL: URL
   232	    fileprivate let databaseQueue: DatabaseQueue
   233	}

