    73	    private static func deepLink(row: StowerSourceMessageRow) -> URL? {
    74	        // Group chats stay nil: there is no public per-chat URL, and an
    75	        // sms: compose link with the full recipient set CREATES A NEW group
    76	        // instead of matching the existing one (verified on real data,
    77	        // 2026-06-11). Callers must offer their own navigation fallback.
    78	        guard row.chat.style == 45 else {
    79	            return nil
    80	        }
    81	        // chat_identifier is the chat's canonical counterpart address. The
    82	        // participant list can hold several handles for one person (old
    83	        // email + current phone), so picking any of those can open the
    84	        // wrong conversation in Messages.
    85	        let address = row.chat.identifier.trimmingCharacters(in: .whitespaces)
    86	        return address.isEmpty ? nil : URL(string: "sms:\(address)")
    87	    }
