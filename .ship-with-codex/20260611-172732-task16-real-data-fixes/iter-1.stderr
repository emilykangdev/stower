   221	    /// NSFileWriteNoPermissionError blaming the destination, and the POSIX
   222	    /// EACCES/EPERM sits one or more levels down in NSUnderlyingErrorKey.
   223	    private static func isPermissionDenied(_ error: Error) -> Bool {
   224	        var current: NSError? = error as NSError
   225	        while let nsError = current {
