   211	    internal static func classify(_ error: Error, sourceURL: URL) -> StowerMessagesError {
   212	        if permissionDenialImplicatesSource(error, sourceURL: sourceURL) {
   213	            return .fullDiskAccessMissing(sourceURL.path)
   214	        }
   215	        return .unreadableSource((error as NSError).localizedDescription)
   216	    }
   217	
   218	    /// Reports whether a permission denial in the error chain is attributable to
   219	    /// the source database rather than the staging destination.
   220	    ///
   221	    /// `classify` sees failures from the whole copy pipeline — staging
   222	    /// `createDirectory`, the source `copyItem`, and the `moveItem` into place —
   223	    /// so an unwritable `temporaryDirectory` also surfaces EACCES/EPERM. Full
   224	    /// Disk Access is only the right diagnosis when the denied path is the source
   225	    /// DB (or a source sidecar), or when the denial carries no path to attribute
   226	    /// at all. A denial that names only a destination path is a staging-write
   227	    /// failure, not a TCC denial on `chat.db`.
   228	    private static func permissionDenialImplicatesSource(
   229	        _ error: Error,
   230	        sourceURL: URL
   231	    ) -> Bool {
   232	        let sourcePaths = sourcePathSet(for: sourceURL)
   233	        var sawDenial = false
   234	        var sawDestinationDenial = false
   235	        var current: NSError? = error as NSError
   236	        while let nsError = current {
   237	            if isPOSIXDenial(nsError) || isCocoaDenial(nsError) {
   238	                sawDenial = true
   239	                if let path = deniedPath(in: nsError) {
   240	                    if sourcePaths.contains(path) {
   241	                        return true
   242	                    }
   243	                    sawDestinationDenial = true
   244	                }
   245	            }
   246	            current = nsError.userInfo[NSUnderlyingErrorKey] as? NSError
   247	        }
   248	        return sawDenial && !sawDestinationDenial
   249	    }
   250	
   251	    /// The source DB path plus its WAL/SHM sidecars, normalized for comparison
   252	    /// against the path Cocoa records on a file error.
   253	    private static func sourcePathSet(for sourceURL: URL) -> Set<String> {
   254	        let base = sourceURL.path
   255	        return Set([base, base + "-wal", base + "-shm"].map(normalizedPath))
   256	    }
   257	
   258	    /// The file path a Cocoa/POSIX error blames, if any, normalized for comparison.
   259	    private static func deniedPath(in error: NSError) -> String? {
   260	        if let path = error.userInfo[NSFilePathErrorKey] as? String {
   261	            return normalizedPath(path)
   262	        }
   263	        if let url = error.userInfo[NSURLErrorKey] as? URL {
   264	            return normalizedPath(url.path)
   265	        }
   266	        return nil
   267	    }
   268	
   269	    private static func normalizedPath(_ path: String) -> String {
   270	        URL(fileURLWithPath: path).standardizedFileURL.path
