     4	internal struct StowerSourceMessageRow: Decodable, FetchableRecord, Sendable {
     5	    internal let messageRowID: Int64
     6	    internal let guid: String
     7	    internal let text: String?
     8	    internal let attributedBody: Data?
     9	    internal let rawDate: Int64
    10	    internal let isFromMe: Bool
    11	    internal let handleID: Int64
    12	    internal let senderHandle: String?
    13	    internal let associatedMessageType: Int64
    14	    internal let itemType: Int64
    15	    internal let hasAttachments: Bool
    16	    internal let balloonBundleID: String?
    17	    internal let chat: StowerSourceChatRow
    18	
    19	    private enum CodingKeys: String, CodingKey {
    20	        case messageRowID = "message_row_id"
    21	        case guid = "message_guid"
    22	        case text
    23	        case attributedBody = "attributed_body"
    24	        case rawDate = "raw_date"
    25	        case isFromMe = "is_from_me"
    26	        case handleID = "handle_id"
    27	        case senderHandle = "sender_handle"
    28	        case associatedMessageType = "associated_message_type"
    29	        case itemType = "item_type"
    30	        case hasAttachments = "has_attachments"
    31	        case balloonBundleID = "balloon_bundle_id"
    32	        case chat
    33	    }
    34	
    35	    internal init(row: Row) throws {
    36	        messageRowID = row["message_row_id"]
    37	        guid = row["message_guid"]
    38	        text = row["text"]
    39	        attributedBody = row["attributed_body"]
    40	        rawDate = row["raw_date"]
    41	        isFromMe = row["is_from_me"]
    42	        handleID = row["handle_id"]
    43	        senderHandle = row["sender_handle"]
    44	        associatedMessageType = row["associated_message_type"]
    45	        itemType = row["item_type"]
    46	        hasAttachments = row["has_attachments"]
    47	        balloonBundleID = row["balloon_bundle_id"]
    48	        chat = try StowerSourceChatRow(row: row)
    49	    }
    50	}
    51	
    52	internal struct StowerSourceChatRow: Decodable, FetchableRecord, Sendable {
    53	    internal let rowID: Int64
    54	    internal let guid: String?
    55	    internal let identifier: String
    56	    internal let displayName: String?
    57	    internal let style: Int64
    58	
    59	    private enum CodingKeys: String, CodingKey {
    60	        case rowID = "chat_row_id"
    61	        case guid = "chat_guid"
    62	        case identifier = "chat_identifier"
    63	        case displayName = "chat_display_name"
    64	        case style = "chat_style"
    65	    }
    66	
    67	    internal init(row: Row) throws {
    68	        rowID = row["chat_row_id"]
    69	        guid = row["chat_guid"]
    70	        identifier = row["chat_identifier"]
    71	        displayName = row["chat_display_name"]
    72	        style = row["chat_style"]
    73	    }
    74	}

